{
  "name": "ai-packet-sniffer",
  "version": "0.1.0",
  "description": "抓包本机所有进程发起的 AI 请求，按地址聚合，按微信聊天模式回放",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .",
    "build:web": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:web && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "vue-tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/node-forge": "^1.3.11",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0",
    "wait-on": "^8.0.1"
  }
}
