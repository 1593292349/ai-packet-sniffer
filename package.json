{
  "name": "ai-packet-sniffer",
  "version": "0.1.0",
  "description": "抓包本机所有进程发起的 AI 请求，按地址聚合，按微信聊天模式回放",
  "main": "dist/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/project.js dev",
    "build": "node scripts/project.js build",
    "test": "node scripts/project.js test"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "ant-design-vue": "^4.2.6",
    "codemirror": "^6.0.2",
    "markdown-it": "^14.2.0",
    "node-forge": "^1.3.1",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.5.0",
    "@types/node-forge": "^1.3.11",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  },
  "build": {
    "appId": "com.aipacketsniffer.desktop",
    "productName": "AI Packet Sniffer",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "dist/renderer/**/*",
      "dist/electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
